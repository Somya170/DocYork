**/*.wal
**/backend/data/
**/*.db
**/*.log

# Node/React ignore
**/node_modules/
**/dist/
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.eslintcache
**/.vite

